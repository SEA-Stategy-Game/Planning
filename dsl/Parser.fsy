%{
open Lang
%}

// start token
%start start

// token, used by lexer
%token <int> INT
%token STAR
%token SLASH
%token PLUS
%token MINUS
%token LEFT_PAREN
%token RIGHT_PAREN
%token EOF

// precedence and associativity
%left TOKEN1 TOKEN2
%left TOKEN3 TOKEN4

// return type of parser, marked by start token
%type <Expr option> start

%%

// production rules:
// rule name: matching expression with TERMINAL and non-terminals { action as F# code }
start: prog { $1 }

prog:
  | EOF { None }
  | expr { Some $1 }


// $1 = first token in the expression
// expr1 PLUS expr2 -> $1 = expr1 
expr:
  | INT { Int $1 }
  | expr PLUS expr { InfixApp ($1, Operator.AddOp, $3) }
  | expr MINUS expr { InfixApp ($1, Operator.SubOp, $3) }
  | expr SLASH expr { InfixApp ($1, Operator.MulOp, $3) }
  | expr STAR expr { InfixApp ($1, Operator.DivOp, $3) }